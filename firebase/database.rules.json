{
  "rules": {
    "articles": {
      "$sellerId": {
        ".read": "auth != null",
        ".write": "auth != null && $sellerId === auth.uid"
      }
    },
    "seller_articles": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$articleId": {
          ".validate": "newData.parent().parent().parent().child('articles').child($sellerId).child($articleId).exists()"
        }
      }
    },
    "sales": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$month": {
          "$saleId": {
            ".write": "auth != null && auth.uid === $sellerId && !data.exists()",
            ".validate": "$month.matches(/^[0-9]{6}$/) && newData.hasChildren(['orderId', 'confirmedAt', 'lines']) && newData.parent().parent().parent().parent().child('sale_index').child($sellerId).child(newData.child('orderId').val()).child($saleId).val() === $month"
          }
        }
      }
    },
    "sale_index": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$orderId": {
          "$saleId": {
            ".write": "auth != null && auth.uid === $sellerId && !data.exists()",
            ".validate": "newData.isString() && newData.parent().parent().parent().parent().child('sales').child($sellerId).child(newData.val()).child($saleId).child('orderId').val() === $orderId"
          }
        }
      }
    },
    "stock_movements": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$month": {
          "$movementId": {
            ".write": "auth != null && auth.uid === $sellerId && !data.exists()",
            ".validate": "$month.matches(/^[0-9]{6}$/) && newData.hasChildren(['articleId', 'quantity', 'unit', 'kind', 'source', 'recordedAt']) && (newData.child('kind').val() !== 'STOCKTAKE' || newData.child('countedTo').exists())",
            "id": { ".validate": "newData.isString()" },
            "articleId": { ".validate": "newData.isString() && newData.val().length > 0" },
            "productId": { ".validate": "newData.isString()" },
            "quantity": { ".validate": "newData.isNumber()" },
            "unit": { ".validate": "newData.isString() && newData.val().length > 0" },
            "kind": { ".validate": "newData.val() === 'INTAKE' || newData.val() === 'STOCKTAKE' || newData.val() === 'SALE' || newData.val() === 'LOSS'" },
            "source": { ".validate": "newData.val() === 'MANUAL' || newData.val() === 'SCALE' || newData.val() === 'ORDERED'" },
            "recordedAt": { ".validate": "newData.isNumber()" },
            "countedTo": { ".validate": "newData.isNumber()" },
            "note": { ".validate": "newData.isString()" },
            "saleId": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "stock": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$articleId": {
          ".validate": "newData.hasChildren(['onHand', 'unit'])",
          "onHand": { ".validate": "newData.isNumber()" },
          "unit": { ".validate": "newData.isString() && newData.val().length > 0" },
          "lastMovementAt": { ".validate": "newData.isNumber()" },
          "lastCountedAt": { ".validate": "newData.isNumber()" },
          "lastSource": { ".validate": "newData.val() === 'MANUAL' || newData.val() === 'SCALE' || newData.val() === 'ORDERED'" },
          "$other": { ".validate": false }
        }
      }
    },
    "seller_profile": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && $sellerId === auth.uid",
        "$field": {
          ".read": "auth != null && $field !== 'knownClientIds' && $field !== 'blockedClientIds' && $field !== 'approvedBuyerIds'"
        }
      }
    },
    "markets": {
      "$sellerId": {
        ".read": "auth != null",
        ".write": "auth != null && $sellerId === auth.uid",
        "$marketId": {
          ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').val() === $marketId",
          "id": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "street": { ".validate": "newData.isString()" },
          "houseNumber": { ".validate": "newData.isString()" },
          "city": { ".validate": "newData.isString()" },
          "zipCode": { ".validate": "newData.isString()" },
          "dayOfWeek": { ".validate": "newData.isString()" },
          "begin": { ".validate": "newData.isString()" },
          "end": { ".validate": "newData.isString()" },
          "dayIndex": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 6" },
          "active": { ".validate": "newData.isBoolean()" },
          "allowsDelivery": { ".validate": "newData.isBoolean()" },
          "contacts": {
            "$index": {
              ".validate": "newData.hasChildren(['channel', 'value'])",
              "channel": { ".validate": "newData.isString()" },
              "value": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "label": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "$other": { ".validate": false }
            }
          },
          "pricingRevision": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "priceConditions": {
            "$index": {
              ".validate": "newData.hasChildren(['cause', 'effect', 'amount'])",
              "cause": { ".validate": "newData.isString()" },
              "scopeType": { ".validate": "newData.isString()" },
              "scopeValue": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "effect": { ".validate": "newData.val() === 'FACTOR' || newData.val() === 'SURCHARGE' || newData.val() === 'DISCOUNT'" },
              "amount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
              "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "seller_ui_actions": {
      "$sellerId": {
        ".read": "auth != null",
        ".write": "auth != null && $sellerId === auth.uid",
        "$actionId": {
          ".validate": "newData.hasChildren(['id', 'kind', 'label', 'value', 'location']) && newData.child('id').val() === $actionId",
          "id": { ".validate": "newData.isString()" },
          "kind": { ".validate": "(newData.val() === 'OPEN_URL' && newData.parent().child('location').val() !== 'TOPBAR_HOME_TITLE') || (newData.val() === 'ANNOUNCE' && newData.parent().child('location').val() === 'TOPBAR_HOME_TITLE')" },
          "label": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
          "value": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500 && (newData.parent().child('kind').val() === 'ANNOUNCE' || (!newData.val().contains(':') && !newData.val().beginsWith('/')))" },
          "location": { ".validate": "newData.val() === 'TOPBAR_HOME' || newData.val() === 'TOPBAR_PROFILE' || newData.val() === 'TOPBAR_HOME_TITLE'" },
          "audience": { ".validate": "newData.val() === 'EVERYONE' || newData.val() === 'DEMO_ONLY' || newData.val() === 'APPROVED_ONLY'" },
          "$other": { ".validate": false }
        }
      }
    },
    "orders": {
      "$sellerId": {
        ".read": "auth != null && $sellerId === auth.uid",
        "$date": {
          "$orderId": {
            ".read": "auth != null && ($sellerId === auth.uid || data.child('buyerId').val() === auth.uid)",
            ".write": "auth != null && ($sellerId === auth.uid || (data.child('buyerId').val() === auth.uid || !data.exists()) && root.child('buyer_access_status').child($sellerId).child(auth.uid).child('status').val() !== 'BLOCKED')",
            ".validate": "auth.uid === $sellerId || newData.child('buyerId').val() === auth.uid",
            "origin": { ".validate": "newData.val() === 'PRODUCTION' || newData.val() === 'TRANSITIONED'" },
            "fulfilment": { ".validate": "newData.val() === 'PICKUP' || (newData.val() === 'DELIVERY' && (!newData.parent().child('marketId').exists() || newData.parent().child('marketId').val() === '' || root.child('markets').child($sellerId).child(newData.parent().child('marketId').val()).child('allowsDelivery').val() !== false))" },
            "deliveryAddress": {
              ".validate": "newData.hasChildren(['street', 'houseNumber'])",
              "street": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 200" },
              "houseNumber": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 40" },
              "zipCode": { ".validate": "newData.isString() && newData.val().length < 20" },
              "city": { ".validate": "newData.isString() && newData.val().length < 120" },
              "note": { ".validate": "newData.isString() && newData.val().length < 300" }
            },
            "marketId": { ".validate": "newData.isString() && (newData.val() === '' || root.child('markets').child($sellerId).child(newData.val()).exists())" },
            "pricingRevision": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },
    "demo_orders": {
      "$sellerId": {
        ".read": "auth != null",
        "$date": {
          "$orderId": {
            ".write": "auth != null && (data.child('buyerId').val() === auth.uid || !data.exists())",
            ".validate": "newData.child('buyerId').val() === auth.uid",
            "origin": { ".validate": "newData.val() === 'DEMO'" },
            "fulfilment": { ".validate": "newData.val() === 'PICKUP' || (newData.val() === 'DELIVERY' && (!newData.parent().child('marketId').exists() || newData.parent().child('marketId').val() === '' || root.child('markets').child($sellerId).child(newData.parent().child('marketId').val()).child('allowsDelivery').val() !== false))" },
            "deliveryAddress": {
              ".validate": "newData.hasChildren(['street', 'houseNumber'])",
              "street": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 200" },
              "houseNumber": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 40" },
              "zipCode": { ".validate": "newData.isString() && newData.val().length < 20" },
              "city": { ".validate": "newData.isString() && newData.val().length < 120" },
              "note": { ".validate": "newData.isString() && newData.val().length < 300" }
            },
            "pricingRevision": { ".validate": "newData.isNumber() && newData.val() >= 0" }
          }
        }
      }
    },
    "buyer_profile": {
      "$userId": {
        ".read": "auth != null && $userId === auth.uid",
        ".write": "auth != null && $userId === auth.uid"
      }
    },
    "invitations": {
      "$invitationId": {
        ".read": "auth != null && (data.child('sellerId').val() === auth.uid || data.child('buyerId').val() === auth.uid || data.child('buyerId').val() === null)",
        ".write": "auth != null && ((!data.exists() && newData.child('sellerId').val() === auth.uid) || (data.exists() && data.child('sellerId').val() === auth.uid) || (data.exists() && data.child('buyerId').val() === auth.uid && data.child('status').val() === 'PENDING'))",
        ".validate": "!data.exists() || !newData.exists() || newData.child('sellerId').val() === data.child('sellerId').val()"
      }
    },
    "buyer_invitations": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        "$invitationId": {
          ".write": "auth != null && ($buyerId === auth.uid || root.child('invitations').child($invitationId).child('sellerId').val() === auth.uid)"
        }
      }
    },
    "invite_tokens": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$token": {
          ".read": "auth != null && (auth.uid === $sellerId || !data.child('redeemedBy').exists() || data.child('redeemedBy').val() === auth.uid)",
          ".write": "auth != null && (auth.uid === $sellerId || (data.exists() && newData.exists() && !data.child('redeemedBy').exists() && newData.child('redeemedBy').val() === auth.uid && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('expiresAt').val() === data.child('expiresAt').val() && newData.child('displayNameHint').val() === data.child('displayNameHint').val() && newData.child('grantsMarkets').val() === data.child('grantsMarkets').val() && now < data.child('expiresAt').val()))",
          ".validate": "newData.hasChildren(['createdAt', 'expiresAt'])",
          "createdAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "redeemedBy": { ".validate": "newData.isString()" },
          "displayNameHint": { ".validate": "newData.isString()" },
          "grantsMarkets": { ".validate": "newData.isString() && newData.val().length <= 2000" },
          "$other": { ".validate": false }
        }
      }
    },
    "buyer_access_status": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$buyerUid": {
          ".read": "auth != null && (auth.uid === $sellerId || $buyerUid === auth.uid)",
          ".write": "auth != null && (auth.uid === $sellerId || ($buyerUid === auth.uid && (!data.exists() ? ((newData.child('status').val() === 'PENDING' && !newData.child('allowedMarkets').exists()) || (newData.child('status').val() === 'APPROVED' && newData.child('viaToken').exists() && root.child('invite_tokens').child($sellerId).child(newData.child('viaToken').val()).child('redeemedBy').val() === auth.uid && (newData.child('allowedMarkets').val() === root.child('invite_tokens').child($sellerId).child(newData.child('viaToken').val()).child('grantsMarkets').val() || (!root.child('invite_tokens').child($sellerId).child(newData.child('viaToken').val()).child('grantsMarkets').exists() && newData.child('allowedMarkets').val() === '')))) : (data.child('status').val() !== 'BLOCKED' && (!newData.exists() || (newData.child('status').val() === data.child('status').val() && newData.child('allowedMarkets').val() === data.child('allowedMarkets').val()))))))",
          "viaToken": { ".validate": "newData.isString()" },
          "allowedMarkets": { ".validate": "newData.isString() && newData.val().length <= 2000" }
        }
      }
    },
    "seller_events": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$eventId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('firebaseUserId').val() === auth.uid && root.child('buyer_access_status').child($sellerId).child(auth.uid).child('status').val() === 'APPROVED') || (auth.uid === $sellerId && !newData.exists()))",
          ".validate": "newData.hasChildren(['id', 'sellerId', 'type', 'buyerId', 'firebaseUserId', 'timestamp', 'timestampIso']) && newData.child('sellerId').val() === $sellerId"
        }
      }
    },
    "access_requests": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$buyerUid": {
          ".read": "auth != null && $buyerUid === auth.uid",
          ".write": "auth != null && $buyerUid === auth.uid && root.child('buyer_access_status').child($sellerId).child($buyerUid).child('status').val() !== 'BLOCKED'",
          "marketId": { ".validate": "newData.isString() && (newData.val() === '' || root.child('markets').child($sellerId).child(newData.val()).exists())" }
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
        ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))"
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
        "$messageId": {
          ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && (data.exists() ? data.child('senderId').val() === auth.uid : newData.hasChildren(['senderId', 'timestamp']) && newData.child('senderId').val() === auth.uid)",
          "isRead": {
            ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
            ".validate": "newData.isBoolean() && newData.parent().child('senderId').exists()"
          }
        }
      }
    },
    "user_conversations": {
      "$userId": {
        ".read": "auth != null && $userId === auth.uid",
        "$conversationId": {
          ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && ($conversationId.beginsWith($userId + '_') || $conversationId.endsWith('_' + $userId))"
        }
      }
    },
    "buyer_contacts": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        ".write": "auth != null && $buyerId === auth.uid"
      }
    },
    "buyer_blocked": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        ".write": "auth != null && $buyerId === auth.uid"
      }
    }
  }
}
