{
  "rules": {
    "articles": {
      "$sellerId": {
        ".read": "auth != null",
        ".write": "auth != null && $sellerId === auth.uid"
      }
    },
    "seller_articles": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$articleId": {
          ".validate": "newData.parent().parent().parent().child('articles').child($sellerId).child($articleId).exists()"
        }
      }
    },
    "sales": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$month": {
          "$saleId": {
            ".write": "auth != null && auth.uid === $sellerId && !data.exists()",
            ".validate": "$month.matches(/^[0-9]{6}$/) && newData.hasChildren(['orderId', 'confirmedAt', 'lines']) && newData.parent().parent().parent().parent().child('sale_index').child($sellerId).child(newData.child('orderId').val()).child($saleId).val() === $month"
          }
        }
      }
    },
    "sale_index": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$orderId": {
          "$saleId": {
            ".write": "auth != null && auth.uid === $sellerId && !data.exists()",
            ".validate": "newData.isString() && newData.parent().parent().parent().parent().child('sales').child($sellerId).child(newData.val()).child($saleId).child('orderId').val() === $orderId"
          }
        }
      }
    },
    "seller_profile": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && $sellerId === auth.uid",
        "$field": {
          ".read": "auth != null && $field !== 'knownClientIds' && $field !== 'blockedClientIds' && $field !== 'approvedBuyerIds'"
        }
      }
    },
    "orders": {
      "$sellerId": {
        ".read": "auth != null && $sellerId === auth.uid",
        "$date": {
          "$orderId": {
            ".read": "auth != null && ($sellerId === auth.uid || data.child('buyerId').val() === auth.uid)",
            ".write": "auth != null && ($sellerId === auth.uid || (data.child('buyerId').val() === auth.uid || !data.exists()) && root.child('buyer_access_status').child($sellerId).child(auth.uid).child('status').val() !== 'BLOCKED')",
            ".validate": "auth.uid === $sellerId || newData.child('buyerId').val() === auth.uid"
          }
        }
      }
    },
    "demo_orders": {
      "$sellerId": {
        ".read": "auth != null",
        "$date": {
          "$orderId": {
            ".write": "auth != null && (data.child('buyerId').val() === auth.uid || !data.exists())",
            ".validate": "newData.child('buyerId').val() === auth.uid"
          }
        }
      }
    },
    "buyer_profile": {
      "$userId": {
        ".read": "auth != null && $userId === auth.uid",
        ".write": "auth != null && $userId === auth.uid"
      }
    },
    "invitations": {
      "$invitationId": {
        ".read": "auth != null && (data.child('sellerId').val() === auth.uid || data.child('buyerId').val() === auth.uid || data.child('buyerId').val() === null)",
        ".write": "auth != null && ((!data.exists() && newData.child('sellerId').val() === auth.uid) || (data.exists() && data.child('sellerId').val() === auth.uid) || (data.exists() && data.child('buyerId').val() === auth.uid && data.child('status').val() === 'PENDING'))",
        ".validate": "!data.exists() || !newData.exists() || newData.child('sellerId').val() === data.child('sellerId').val()"
      }
    },
    "buyer_invitations": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        "$invitationId": {
          ".write": "auth != null && ($buyerId === auth.uid || root.child('invitations').child($invitationId).child('sellerId').val() === auth.uid)"
        }
      }
    },
    "invite_tokens": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$token": {
          ".read": "auth != null && (auth.uid === $sellerId || !data.child('redeemedBy').exists() || data.child('redeemedBy').val() === auth.uid)",
          ".write": "auth != null && (auth.uid === $sellerId || (data.exists() && newData.exists() && !data.child('redeemedBy').exists() && newData.child('redeemedBy').val() === auth.uid && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('expiresAt').val() === data.child('expiresAt').val() && newData.child('displayNameHint').val() === data.child('displayNameHint').val() && now < data.child('expiresAt').val()))",
          ".validate": "newData.hasChildren(['createdAt', 'expiresAt'])",
          "createdAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "redeemedBy": { ".validate": "newData.isString()" },
          "displayNameHint": { ".validate": "newData.isString()" },
          "$other": { ".validate": false }
        }
      }
    },
    "buyer_access_status": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$buyerUid": {
          ".read": "auth != null && (auth.uid === $sellerId || $buyerUid === auth.uid)",
          ".write": "auth != null && (auth.uid === $sellerId || ($buyerUid === auth.uid && (!data.exists() ? (newData.child('status').val() === 'PENDING' || (newData.child('status').val() === 'APPROVED' && newData.child('viaToken').exists() && root.child('invite_tokens').child($sellerId).child(newData.child('viaToken').val()).child('redeemedBy').val() === auth.uid)) : (data.child('status').val() !== 'BLOCKED' && (!newData.exists() || newData.child('status').val() === data.child('status').val())))))",
          "viaToken": { ".validate": "newData.isString()" }
        }
      }
    },
    "seller_events": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        "$eventId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('firebaseUserId').val() === auth.uid && root.child('buyer_access_status').child($sellerId).child(auth.uid).child('status').val() === 'APPROVED') || (auth.uid === $sellerId && !newData.exists()))",
          ".validate": "newData.hasChildren(['id', 'sellerId', 'type', 'buyerId', 'firebaseUserId', 'timestamp', 'timestampIso']) && newData.child('sellerId').val() === $sellerId"
        }
      }
    },
    "access_requests": {
      "$sellerId": {
        ".read": "auth != null && auth.uid === $sellerId",
        ".write": "auth != null && auth.uid === $sellerId",
        "$buyerUid": {
          ".read": "auth != null && $buyerUid === auth.uid",
          ".write": "auth != null && $buyerUid === auth.uid && root.child('buyer_access_status').child($sellerId).child($buyerUid).child('status').val() !== 'BLOCKED'"
        }
      }
    },
    "conversations": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
        ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))"
      }
    },
    "messages": {
      "$conversationId": {
        ".read": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
        "$messageId": {
          ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && (data.exists() ? data.child('senderId').val() === auth.uid : newData.hasChildren(['senderId', 'timestamp']) && newData.child('senderId').val() === auth.uid)",
          "isRead": {
            ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid))",
            ".validate": "newData.isBoolean() && newData.parent().child('senderId').exists()"
          }
        }
      }
    },
    "user_conversations": {
      "$userId": {
        ".read": "auth != null && $userId === auth.uid",
        "$conversationId": {
          ".write": "auth != null && ($conversationId.beginsWith(auth.uid + '_') || $conversationId.endsWith('_' + auth.uid)) && ($conversationId.beginsWith($userId + '_') || $conversationId.endsWith('_' + $userId))"
        }
      }
    },
    "buyer_contacts": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        ".write": "auth != null && $buyerId === auth.uid"
      }
    },
    "buyer_blocked": {
      "$buyerId": {
        ".read": "auth != null && $buyerId === auth.uid",
        ".write": "auth != null && $buyerId === auth.uid"
      }
    }
  }
}
