{
  "_test": {
    "fixture": "legacy-edges",
    "summary": "Records written by older app versions, plus the awkward cases.",
    "generatedFor": "2026-10-22",
    "regenerate": "python3 firebase/fixtures/generate_fixtures.py",
    "warning": "Importing at the database root REPLACES the whole database.",
    "seller": "cPkcZSiF3LMXjWoqW6AqpA9paoO2",
    "buyers": {
      "bcQHALrRkuSljXKdO6sxhHlnhNv2": "Anna Berger — approved, full profile",
      "mX4gbxB5wuNUmfj9U4PWhO7BOJD3": "unnamed buyer — not approved (demo), stored placeholder name",
      "jOSoP5UxAohZDtdpluhHg6VrfvQ2": "Tobias Krenz — approved and market-scoped (BLOCKED in fixture 3)"
    },
    "markets": {
      "mkt-thu-onkel-tom": "Donnerstag, delivers",
      "mkt-sat-kranoldplatz": "Samstag (price conditions), pickup only",
      "mkt-mon-breitenbachplatz": "Montag, pickup only",
      "mkt-popup-hofladen": "pop-up, runs tomorrow, delivers"
    },
    "dates": {
      "legacyPickup": "20260924",
      "notPickedUp": "20261008",
      "deliveryPickup": "20261029",
      "ledgerMonth": "202610"
    },
    "timeZone": "Europe/Berlin",
    "cases": [
      {
        "id": "F3-01",
        "title": "A pre-market order still reads",
        "where": "sell flavour, order detail",
        "steps": [
          "Open ord-f3-legacy-universe."
        ],
        "expect": "marketId is empty and pricingRevision absent → no market name, no price breakdown, and the amounts render as '2,000 kg' from amountCount rather than the stored bare '2.0'. piecesCount 2147483647 must not show."
      },
      {
        "id": "F3-02",
        "title": "The retired demo encoding is recovered",
        "where": "sell flavour after approving mX4gbxB5wuNUmfj9U4PWhO7BOJD3",
        "steps": [
          "Approve the pending buyer."
        ],
        "expect": "ord-f3-demo-legacy (isDemoOrder + status DEMO_ORDER) moves into /orders as origin TRANSITIONED with a real lifecycle status; ord-f3-demo-stale, whose pickup has passed, is dropped, not moved."
      },
      {
        "id": "F3-03",
        "title": "A blocked buyer cannot order",
        "where": "buy flavour as jOSoP5UxAohZDtdpluhHg6VrfvQ2",
        "steps": [
          "Try to place an order."
        ],
        "expect": "The write is refused by the rules and the app says so. The buyer also cannot overwrite their own BLOCKED access record."
      },
      {
        "id": "F3-04",
        "title": "A deactivated market still resolves",
        "where": "sell flavour, order history",
        "steps": [
          "Open ord-f3-inactive-market."
        ],
        "expect": "Breitenbachplatz shows its name although active is false, and the stall is no longer offered as a pickup slot. Markets are deactivated, never deleted, for exactly this."
      },
      {
        "id": "F3-05",
        "title": "Delivery without an address",
        "where": "sell flavour, order list",
        "steps": [
          "Look at ord-f3-delivery-no-address."
        ],
        "expect": "The order is flagged as a delivery the seller cannot deliver, rather than showing a blank address block."
      },
      {
        "id": "F3-06",
        "title": "An unknown price cause is dropped, not invented",
        "where": "both flavours, ord-f3-delivery-ok",
        "steps": [
          "Open the price breakdown."
        ],
        "expect": "HANDLING shows; LOYALTY_BONUS is silently dropped (PriceComponentDto returns null for a cause this build does not know) and the charged price 4,60 € stays as recorded."
      },
      {
        "id": "F3-07",
        "title": "Seller intent outranks the ledger",
        "where": "both flavours, Weißer Spargel",
        "steps": [
          "Book an intake for Spargel in the seller app."
        ],
        "expect": "sellerAvailable is false, so the article stays unavailable to buyers. Restocking must not undo 'off for the season'."
      },
      {
        "id": "F3-08",
        "title": "A gated article that really is empty",
        "where": "both flavours, Lindenhonig",
        "steps": [
          "Compare the tile with the stock screen."
        ],
        "expect": "onHand 0 with lastCountedAt set is a real zero: available false, band LAST_FEW. Contrast with F1-07, where onHand is simply unknown."
      },
      {
        "id": "F3-09",
        "title": "An article with no private half",
        "where": "sell flavour, Walnüsse",
        "steps": [
          "Open the article editor and the margin column."
        ],
        "expect": "sellerData is null: the purchase price shows as unknown, never as 0,00 €, and saving must not write a private half full of zeroes."
      },
      {
        "id": "F3-10",
        "title": "A legacy buyer profile still loads",
        "where": "buy flavour as mX4gbxB5wuNUmfj9U4PWhO7BOJD3",
        "steps": [
          "Log in and open the profile screen."
        ],
        "expect": "The profile carries defaultTime, favouriteProductIds and anonymous as 0. It loads, and saving migrates it to the current field names."
      },
      {
        "id": "F3-11",
        "title": "Invite tokens: valid, expired, spent",
        "where": "buy flavour, invite links",
        "steps": [
          "Redeem tok-valid-sat, then tok-expired, then tok-redeemed."
        ],
        "expect": "The first grants APPROVED scoped to the Kranoldplatz stall only. The other two are refused — and no redemption may widen the granted markets."
      },
      {
        "id": "F3-12",
        "title": "An action with no audience reaches everyone",
        "where": "buy flavour as each buyer",
        "steps": [
          "Check the home top bar."
        ],
        "expect": "'Rezepte' is visible to all three buyers. A missing audience must read as EVERYONE, not as nobody."
      },
      {
        "id": "F3-16",
        "title": "A delivery order outlives the market's delivery",
        "where": "console, then sell and buy flavours",
        "steps": [
          "Upload the fixture, then set markets/<seller>/mkt-popup-hofladen/allowsDelivery to false in the console."
        ],
        "expect": "ord-f3-delivery-ok stays a DELIVERY with its address — the seller may already have loaded the van, and a capability change does not retract a placed order. Editing it coerces it to a pickup and says so; the rules refuse any write that keeps it a delivery."
      },
      {
        "id": "F3-15",
        "title": "The weighPerPiece typo",
        "where": "both flavours, Knoblauch",
        "steps": [
          "Open the Knoblauch tile and the seller's article editor."
        ],
        "expect": "The stored field is the legacy 'weighPerPiece', which the current reader does not look at, so the piece weight is 0,00 kg. Either the reader accepts both spellings or the editor heals it on the next save — it must not show a wrong weight or crash."
      },
      {
        "id": "F3-14",
        "title": "An order survives its day being closed",
        "where": "sell flavour, order list",
        "steps": [
          "Look at the orders on the closed Thursday."
        ],
        "expect": "ord-f3-delivery-no-address sits on a day the seller closed afterwards. The order must still be listed and openable — a closure removes a day from what is *offered*, it does not retract orders already placed."
      },
      {
        "id": "F3-13",
        "title": "Every pickup day this week is closed",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Open the pickup slot picker."
        ],
        "expect": "The seller-wide closure removes the next Thursday, the Monday stall is inactive, so only the Saturday and pop-up stalls offer a slot."
      }
    ]
  },
