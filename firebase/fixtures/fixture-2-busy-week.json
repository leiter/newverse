  "_test": {
    "fixture": "busy-week",
    "summary": "A running week: order history, an editable order, a locked one, stock, a booked sale.",
    "generatedFor": "2026-10-22",
    "regenerate": "python3 firebase/fixtures/generate_fixtures.py",
    "warning": "Importing at the database root REPLACES the whole database.",
    "seller": "cPkcZSiF3LMXjWoqW6AqpA9paoO2",
    "buyers": {
      "bcQHALrRkuSljXKdO6sxhHlnhNv2": "Anna Berger — approved, full profile",
      "mX4gbxB5wuNUmfj9U4PWhO7BOJD3": "unnamed buyer — not approved (demo), stored placeholder name",
      "jOSoP5UxAohZDtdpluhHg6VrfvQ2": "Tobias Krenz — approved and market-scoped (BLOCKED in fixture 3)"
    },
    "markets": {
      "mkt-thu-onkel-tom": "Donnerstag",
      "mkt-sat-kranoldplatz": "Samstag (price conditions)",
      "mkt-mon-breitenbachplatz": "Montag",
      "mkt-popup-hofladen": "pop-up, runs tomorrow"
    },
    "dates": {
      "openPickup": "20261029",
      "lockedPickup": "20261023",
      "saturdayPickup": "20261024",
      "closedThursday": "20261119",
      "ledgerMonth": "202610",
      "saleMonth": "202610"
    },
    "timeZone": "Europe/Berlin",
    "cases": [
      {
        "id": "F2-01",
        "title": "Open order is editable, locked order is not",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2 and jOSoP5UxAohZDtdpluhHg6VrfvQ2",
        "steps": [
          "Open Anna's order for next Thursday.",
          "Open Tobias' order for the pop-up stall tomorrow."
        ],
        "expect": "Anna's is editable (deadline is two days before pickup at 23:59); Tobias' is LOCKED and read-only, with the pickup still in the future."
      },
      {
        "id": "F2-02",
        "title": "Order history lists three collected orders",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Open the order history."
        ],
        "expect": "Three COMPLETED orders from the last three Thursdays plus the open one. They resolve through buyer_profile.placedOrderIds (date → orderId)."
      },
      {
        "id": "F2-03",
        "title": "Reorder builds a fresh draft",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Pick the oldest completed order and reorder it."
        ],
        "expect": "A DRAFT with a new id, no pickup date, and today's createdDate; the old order is untouched and prices are re-checked against the catalogue."
      },
      {
        "id": "F2-04",
        "title": "A Saturday order keeps the price it was charged",
        "where": "buy flavour as jOSoP5UxAohZDtdpluhHg6VrfvQ2, seller order detail",
        "steps": [
          "Open the Saturday order and its price breakdown."
        ],
        "expect": "Feigenbananen show 4,84 € with base 4,20 €, a 0,20 € transport surcharge and a 0,44 € stall fee. pricingRevision 3 is on the order; editing the market's conditions must not change these numbers."
      },
      {
        "id": "F2-05",
        "title": "Market scope limits the slots on offer",
        "where": "buy flavour as jOSoP5UxAohZDtdpluhHg6VrfvQ2",
        "steps": [
          "Open the pickup slot picker."
        ],
        "expect": "Only the Kranoldplatz and pop-up stalls appear — allowedMarkets names those two. The Thursday and Monday markets are not offered."
      },
      {
        "id": "F2-06",
        "title": "A closure removes a pickup day",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Scroll the pickup dates four Thursdays out."
        ],
        "expect": "The closed Thursday ('Feiertag') is absent, and the Monday two weeks out is absent for the Breitenbachplatz stall only."
      },
      {
        "id": "F2-07",
        "title": "Scarcity band and derived availability",
        "where": "both flavours, Erdbeeren",
        "steps": [
          "Compare the seller's stock screen with the buyer's tile."
        ],
        "expect": "onHand 10 Schale, 3 committed by the open order, reorderLevel 6 → remaining 7 reads as PLENTIFUL and available stays true. Book 5 more and the band must fall to LIMITED, then LAST_FEW."
      },
      {
        "id": "F2-08",
        "title": "The ledger adds up to the cached level",
        "where": "sell flavour, stock screen",
        "steps": [
          "Open Linda Kartoffeln's stock detail."
        ],
        "expect": "Intake 80 kg then a stocktake to 76,4 kg: the level shows 76,4 and lastCountedAt is set. The stocktake is absolute, not a delta."
      },
      {
        "id": "F2-09",
        "title": "A booked sale is reconciled to its order",
        "where": "sell flavour, bookkeeping",
        "steps": [
          "Export sales for the current month."
        ],
        "expect": "One sale for ord-f2-hist-3 with two lines, found through sale_index/{seller}/{orderId} → yyyyMM. Both halves must agree or the rules would have refused the write."
      },
      {
        "id": "F2-10",
        "title": "Three audiences, three buttons",
        "where": "buy flavour as each buyer",
        "steps": [
          "Check the home and profile top bars as B1, B2 and B3."
        ],
        "expect": "Anna and Tobias (APPROVED) see 'Hofladen' and the profile-bar 'Vorbestellung'; the pending buyer sees 'Hofladen' and 'Erst freischalten'."
      },
      {
        "id": "F2-11",
        "title": "Demo orders stay out of the seller's list",
        "where": "sell flavour",
        "steps": [
          "Open the order list for the next pickup day."
        ],
        "expect": "The two /demo_orders entries from the pending buyer are absent: the seller subscribes to /orders only."
      }
    ]
  },
