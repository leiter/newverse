    "fixture": "cold-start",
    "summary": "A shop with a catalogue and three buyers, and nothing ordered yet.",
    "generatedFor": "2026-10-22",
    "regenerate": "python3 firebase/fixtures/generate_fixtures.py",
    "warning": "Importing at the database root REPLACES the whole database.",
    "seller": "cPkcZSiF3LMXjWoqW6AqpA9paoO2",
    "buyers": {
      "bcQHALrRkuSljXKdO6sxhHlnhNv2": "Anna Berger — approved, full profile",
      "mX4gbxB5wuNUmfj9U4PWhO7BOJD3": "unnamed buyer — not approved (demo), stored placeholder name",
      "jOSoP5UxAohZDtdpluhHg6VrfvQ2": "Tobias Krenz — approved and market-scoped (BLOCKED in fixture 3)"
    },
    "markets": {
      "mkt-thu-onkel-tom": "Donnerstag, delivers",
      "mkt-sat-kranoldplatz": "Samstag (price conditions), pickup only",
      "mkt-mon-breitenbachplatz": "Montag, pickup only",
      "mkt-popup-hofladen": "pop-up, runs tomorrow, delivers"
    },
    "dates": {
      "pickupThu": "20261029",
      "pickupSat": "20261024",
      "pickupMon": "20261026"
    },
    "timeZone": "Europe/Berlin",
    "cases": [
      {
        "id": "F1-01",
        "title": "First run, approved buyer, empty history",
        "where": "buy flavour, sign in as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Open the app and log in as Anna Berger."
        ],
        "expect": "Catalogue shows 8 articles, order history is empty, and the next pickup slots offered are one per market (Mon/Thu/Sat)."
      },
      {
        "id": "F1-02",
        "title": "Market pick is asked once",
        "where": "buy flavour, sign in as jOSoP5UxAohZDtdpluhHg6VrfvQ2",
        "steps": [
          "Log in as Tobias Krenz, whose defaultMarket is empty."
        ],
        "expect": "The scaffold asks which market he collects at, writes it to buyer_profile/defaultMarket, and never asks again."
      },
      {
        "id": "F1-03",
        "title": "Placeholder name reaches the seller",
        "where": "buy flavour as mX4gbxB5wuNUmfj9U4PWhO7BOJD3, then sell flavour",
        "steps": [
          "Place an order as the unnamed buyer.",
          "Open the seller's order list."
        ],
        "expect": "The order shows 'Bodenschatz', not an empty line — the placeholder is stored on the profile, not rendered."
      },
      {
        "id": "F1-04",
        "title": "Pending buyer is gated",
        "where": "buy flavour as mX4gbxB5wuNUmfj9U4PWhO7BOJD3",
        "steps": [
          "Place an order while the access status is PENDING."
        ],
        "expect": "The order is written to /demo_orders, carries origin DEMO, and never appears in the seller's /orders subscription."
      },
      {
        "id": "F1-05",
        "title": "Approved buyer with no market scope sees every stall",
        "where": "buy flavour as bcQHALrRkuSljXKdO6sxhHlnhNv2",
        "steps": [
          "Open the pickup slot picker."
        ],
        "expect": "All three markets are offered: allowedMarkets is the empty string, which MarketScope.decode reads as 'all of them'."
      },
      {
        "id": "F1-06",
        "title": "Seller button is published to everyone",
        "where": "buy flavour, top bar on home",
        "steps": [
          "Look at the home top bar."
        ],
        "expect": "One 'Hofladen' button, opening https://bodenschaetze.example/hofladen. The stored value carries no scheme — the rules refuse a ':'."
      },
      {
        "id": "F1-07",
        "title": "Nothing is stock-gated yet",
        "where": "both flavours",
        "steps": [
          "Check the Erdbeeren tile and the seller's stock screen."
        ],
        "expect": "Erdbeeren are stockGated with no ledger entry at all, so onHand is unknown: available stays true and the scarcity band stays UNKNOWN."
      }
    ]
  },
