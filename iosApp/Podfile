platform :ios, '15.0'

# Map custom Buy/Sell configurations to CocoaPods debug/release types
project 'iosApp', {
  'Debug-Buy'   => :debug,
  'Release-Buy' => :release,
  'Debug-Sell'  => :debug,
  'Release-Sell' => :release
}

target 'iosApp' do
  use_frameworks!

  # KMP shared module — provides Firebase/GoogleSignIn as transitive dependencies
  # Before first pod install: ./gradlew :shared:generateDummyFramework
  pod 'shared', :path => '../shared'

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
    end
  end
end
