default_platform(:ios)

platform :ios do
  ASC_KEY_ID    = ENV["ASC_KEY_ID"]    || "M4S9AWXXL7"
  ASC_ISSUER_ID = ENV["ASC_ISSUER_ID"] || "e3c717d8-00fc-4ff7-8a05-65f96d2b1562"

  # The .p8 is a private key and must never be committed (.gitignore line 59).
  # Preferred home is ~/.appstoreconnect/private_keys, which is where Apple's own
  # tools look; the in-repo path stays last so a CI job can materialise the key
  # next to the Fastfile without editing this file.
  def asc_key_path
    candidates = [
      ENV["ASC_KEY_PATH"],
      File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8"),
      File.expand_path("AuthKey_#{ASC_KEY_ID}.p8", __dir__)
    ].compact

    path = candidates.find { |p| File.exist?(p) }
    UI.user_error!("App Store Connect API key AuthKey_#{ASC_KEY_ID}.p8 not found. Looked in:\n" \
                   "#{candidates.map { |p| "  - #{p}" }.join("\n")}\n" \
                   "Download it from App Store Connect > Users and Access > Integrations, or set ASC_KEY_PATH.") if path.nil?
    path
  end

  def api_key
    path = asc_key_path

    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: path,
      in_house: false
    )
  end

  # The project has no scheme called "iosApp" -- only the two flavour schemes
  # below, each with its own -Buy / -Sell build configurations. Naming a scheme
  # that does not exist makes gym prompt for a choice, which loops forever when
  # running non-interactively (CI, backgrounded shells).
  BUY_SCHEME = "iosApp-Buy"

  desc "Verify the App Store Connect API key resolves and authenticates"
  lane :check_api_key do
    UI.message("Using key #{ASC_KEY_ID} from #{asc_key_path}")
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.together.buy"
    )
    UI.success("Authenticated. Latest TestFlight build for com.together.buy: #{build}")
  end

  desc "Run tests"
  lane :test do
    run_tests(
      workspace: "iosApp.xcworkspace",
      scheme: BUY_SCHEME,
      device: "iPhone 17"
    )
  end

  desc "Build for simulator (debug)"
  lane :build_simulator do
    bump_build
    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: BUY_SCHEME,
      configuration: "Debug-Buy",
      destination: "generic/platform=iOS Simulator",
      skip_archive: true,
      skip_codesigning: true
    )
  end

  desc "Build shared KMP framework"
  lane :build_shared_framework do
    UI.message("Building shared Kotlin framework...")
    sh("cd ../.. && ./gradlew :shared:linkReleaseFrameworkIosArm64")
  end

  desc "Build release for device"
  lane :build do
    build_shared_framework
    bump_build
    build_app(
      workspace: "iosApp.xcworkspace",
      scheme: BUY_SCHEME,
      configuration: "Release-Buy",
      export_method: "app-store",
      clean: true,
      export_options: {
        provisioningProfiles: {
          "com.together.buy" => "BodenschaetzeBuy"
        }
      }
    )
  end

  desc "Upload to TestFlight"
  lane :beta do
    build
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy to App Store"
  lane :deploy do
    build
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end

  desc "Upload metadata and screenshots only"
  lane :deliver_metadata do
    deliver(
      api_key: api_key,
      app_identifier: "com.together.buy",
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true
    )
  end

  desc "Increment build number"
  lane :bump_build do
    increment_build_number(
      xcodeproj: "iosApp.xcodeproj"
    )
    build_number = get_build_number(xcodeproj: "iosApp.xcodeproj")
    UI.message("Build number incremented to #{build_number}")
  end

  desc "Increment version number"
  lane :bump_version do |options|
    bump_type = options[:type] || "patch"
    increment_version_number(
      xcodeproj: "iosApp.xcodeproj",
      bump_type: bump_type
    )
    version = get_version_number(xcodeproj: "iosApp.xcodeproj")
    UI.message("Version incremented to #{version}")
  end

  desc "Sync certificates and provisioning profiles"
  lane :sync_certificates do
    match(
      type: "appstore",
      app_identifier: "com.together.buy",
      readonly: true
    )
  end

  desc "Register new devices and regenerate profiles"
  lane :register_devices_and_regenerate do
    register_devices(
      devices_file: "./fastlane/devices.txt"
    )
    match(
      type: "development",
      force_for_new_devices: true
    )
    match(
      type: "adhoc",
      force_for_new_devices: true
    )
  end
end
