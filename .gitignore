# iOS
# The .xcodeproj itself is checked in - project.pbxproj carries the build
# settings fastlane's bump_build edits, and xcshareddata/xcschemes carries the
# iosApp-Buy / iosApp-Sell schemes the release lanes build. Ignoring it made
# `git add` refuse those tracked files on every build bump. The per-user state
# inside the bundle is covered by the xcuserdata/ and *.xcworkspace rules
# below, which also match nested paths.
*.xcworkspace
!default.xcworkspace
xcuserdata/
*.moved-aside
*.mode1v3
*.mode2v3
*.perspectivev3
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace
DerivedData/
.build/
Pods/

# macOS
.DS_Store

