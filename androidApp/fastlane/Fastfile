require_relative "../../fastlane/release_tag"

default_platform(:android)

platform :android do
  # bump_version_code rewrites this as a side effect of building, so at upload time
  # the edit is still uncommitted. ReleaseTag commits exactly this file before
  # tagging -- otherwise the tag would point at a tree holding the previous code.
  VERSION_FILE = "../version.properties".freeze
  REPO_VERSION_FILE = "androidApp/version.properties".freeze

  def current_version_code
    return 1 unless File.exist?(VERSION_FILE)

    File.readlines(VERSION_FILE).each do |line|
      return line.split("=")[1].strip.to_i if line.start_with?("VERSION_CODE=")
    end
    1
  end

  # Called only after a successful upload. Tagging a build that never reached the
  # store would be worse than not tagging at all.
  def tag_android_release(flavor, track)
    code = current_version_code
    ReleaseTag.tag!(
      name: "android-#{flavor}-#{code}",
      message: "Android #{flavor} versionCode #{code} -> Play #{track}",
      version_files: [REPO_VERSION_FILE]
    )
  end

  # ============================================
  # Test Lanes
  # ============================================

  desc "Run unit tests"
  lane :test do
    gradle(
      task: "test",
      project_dir: ".."
    )
  end

  # ============================================
  # Debug Build Lanes
  # ============================================

  desc "Build debug APK for Buy flavor"
  lane :debug_buy do
    bump_version_code
    gradle(
      task: "assembleBuyDebug",
      project_dir: ".."
    )
    UI.message("APK location: ../androidApp/build/outputs/apk/buy/debug/")
  end

  desc "Build debug APK for Sell flavor"
  lane :debug_sell do
    bump_version_code
    gradle(
      task: "assembleSellDebug",
      project_dir: ".."
    )
    UI.message("APK location: ../androidApp/build/outputs/apk/sell/debug/")
  end

  # ============================================
  # Release APK Build Lanes
  # ============================================

  desc "Build release APK for Buy flavor"
  lane :release_buy do
    bump_version_code
    gradle(
      task: "assembleBuyRelease",
      project_dir: ".."
    )
    UI.message("APK location: ../androidApp/build/outputs/apk/buy/release/")
  end

  desc "Build release APK for Sell flavor"
  lane :release_sell do
    bump_version_code
    gradle(
      task: "assembleSellRelease",
      project_dir: ".."
    )
    UI.message("APK location: ../androidApp/build/outputs/apk/sell/release/")
  end

  # ============================================
  # Release Bundle (AAB) Build Lanes
  # ============================================

  desc "Build release bundle (AAB) for Buy flavor"
  lane :bundle_buy do
    bump_version_code
    gradle(
      task: "bundleBuyRelease",
      project_dir: ".."
    )
    UI.message("AAB location: ../androidApp/build/outputs/bundle/buyRelease/")
  end

  desc "Build release bundle (AAB) for Sell flavor"
  lane :bundle_sell do
    bump_version_code
    gradle(
      task: "bundleSellRelease",
      project_dir: ".."
    )
    UI.message("AAB location: ../androidApp/build/outputs/bundle/sellRelease/")
  end

  # ============================================
  # Play Store Upload Lanes - Buy Flavor
  # ============================================

  desc "Upload Buy flavor to Play Store internal track"
  lane :beta_buy do
    bundle_buy
    upload_to_play_store(
      package_name: "com.together.buy",
      track: "internal",
      aab: "../androidApp/build/outputs/bundle/buyRelease/androidApp-buy-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    tag_android_release("buy", "internal")
  end

  desc "Deploy Buy flavor to Play Store production"
  lane :deploy_buy do
    bundle_buy
    upload_to_play_store(
      package_name: "com.together.buy",
      track: "production",
      aab: "../androidApp/build/outputs/bundle/buyRelease/androidApp-buy-release.aab"
    )
    tag_android_release("buy", "production")
  end

  # ============================================
  # Play Store Upload Lanes - Sell Flavor
  # ============================================

  desc "Upload Sell flavor to Play Store internal track"
  lane :beta_sell do
    bundle_sell
    upload_to_play_store(
      package_name: "com.together.sell",
      track: "internal",
      aab: "../androidApp/build/outputs/bundle/sellRelease/androidApp-sell-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
    tag_android_release("sell", "internal")
  end

  desc "Deploy Sell flavor to Play Store production"
  lane :deploy_sell do
    bundle_sell
    upload_to_play_store(
      package_name: "com.together.sell",
      track: "production",
      aab: "../androidApp/build/outputs/bundle/sellRelease/androidApp-sell-release.aab"
    )
    tag_android_release("sell", "production")
  end

  # ============================================
  # Version Management
  # ============================================

  desc "Increment version code"
  lane :bump_version_code do
    new_version = current_version_code + 1
    File.write(VERSION_FILE, "VERSION_CODE=#{new_version}\n")
    UI.message("Version code incremented to #{new_version}")
  end

  # ============================================
  # Convenience Lanes
  # ============================================

  desc "Build both flavors (debug)"
  lane :debug_all do
    debug_buy
    debug_sell
  end

  desc "Build both flavors (release)"
  lane :release_all do
    release_buy
    release_sell
  end

  desc "Bundle both flavors (release)"
  lane :bundle_all do
    bundle_buy
    bundle_sell
  end
end
