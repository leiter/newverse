<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Order reminder: a local notification, and WorkManager restores its queue after
         a reboot only if it can receive BOOT_COMPLETED. Both are needed for a reminder
         to arrive without the buyer opening the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Still unused by Buy: no foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <!-- play-services-code-scanner merges in GmsBarcodeScanningDelegateActivity with
         android:screenOrientation="portrait". An activity asking for a fixed
         orientation *implies* uses-feature android.hardware.screen.portrait with
         required="true", and Play applies that implication to the whole app: the
         listing then refuses to install on anything that cannot do portrait, which
         Play counts as phones, tablets, desktop and XR. ML Kit locks that activity
         only to stop an invisible delegate being recreated, so the requirement is
         not ours to make.

         Declaring the feature here explicitly is what suppresses the implied one.
         It does not unlock the app's own orientation: the buy app stays portrait on
         phones by width class, which is a layout decision and not a hardware claim. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />

    <application>
        <!-- Buy flavor Activity -->
        <!-- adjustResize, with enableEdgeToEdge() in the activity, is the documented
             pairing: it is what makes the IME inset dispatched consistently. Left
             unset the window is adjustUnspecified, which the framework resolves on the
             first keyboard show and then keeps — and a decision taken once, on the
             first show, is exactly the shape of the bug this was added for: the first
             focus on the profile form padded the content by the bottom bar's height
             *and* the keyboard's, instead of the larger of the two. See
             doc/plans/TODO.md § "The keyboard covered the bottom of every form". -->
        <activity
            android:name=".BuyMainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: newverse://connect?sellerId=xyz -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="newverse"
                    android:host="connect" />
            </intent-filter>

            <!-- Deep link: newverse://contact?buyerId=xyz&name=Max -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="newverse"
                    android:host="contact" />
            </intent-filter>
        </activity>
    </application>

</manifest>
